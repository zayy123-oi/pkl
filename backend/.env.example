# Salin file ini menjadi .env lalu isi nilai sebenarnya secara lokal.
# Ambil URI pada Supabase Dashboard: Project Settings > Database > Connection string.
# Gunakan URI PostgreSQL, bukan publishable/anon key Supabase.
# Untuk direct connection gunakan host db.<project-ref>.supabase.co:5432.
# Untuk pooler gunakan URI pooler yang disediakan Supabase; sslmode tetap diperlukan.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<database-password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_SSLMODE=require

ATTENDANCE_RADIUS_METERS=150
DUPLICATE_WINDOW_MINUTES=5
JWT_SECRET_KEY=ganti-dengan-secret-acak-yang-kuat
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
